# Read alongside ~/.gitconfig, which sandbar re-renders at every create
# (name, email, credential helper). Commit signing is left out on purpose:
# there is no GPG key inside the VM.
[init]
	defaultBranch = main
[alias]
	lg = log --date=local --pretty=format:\"%Cgreen%h%Creset - %an, %ad : %Cblue%s%Creset\"
	sf = show --date=local --pretty=format:\"%Cgreen%h%Creset - %an, %ad : %Cblue%s%Creset\" --name-only
