set nocompatible
filetype plugin indent on
syntax on

" Display
set number
set relativenumber
set ruler
set showcmd
set laststatus=2
set statusline=%f\ %m%r%h%w%=%y\ %l:%c\ %p%%
set scrolloff=5
set wildmenu

" Indentation
set expandtab
set tabstop=2
set shiftwidth=2
set softtabstop=2
set autoindent

" Search
set hlsearch
set incsearch
set ignorecase
set smartcase

" Editing
set backspace=indent,eol,start
set mouse=a
set hidden

" Persistent undo
set undofile
set undodir=~/.vim/undo//
